---
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
const categories = (await getCollection('categories')).sort((a,b) => a.data.order - b.data.order);
const posts = await getCollection('blog', ({data}) => import.meta.env.DEV || data.status === 'published');
---
<Page title="Explore the topics" description="Find practical Marpos Studio guidance on content editing, editorial workflows, and Astro websites.">
  <h1>Explore the topics</h1>
  {categories.map(category => <section id={category.id}>
    <h2>{category.data.title}</h2><p>{category.data.description}</p>
    <ul>{posts.filter(post => post.data.categories.some(item => item.id === category.id)).map(post => <li><a href={`/blog/${post.id}/`}>{post.data.title}</a></li>)}</ul>
  </section>)}
</Page>
