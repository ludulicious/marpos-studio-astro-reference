---
import { sitePath } from '../lib/urls';
import { getCollection, getEntry, render } from 'astro:content';
import Page from '../layouts/Page.astro';
const page = await getEntry('pages', 'team');
if (!page) throw new Error('The team page content is missing.');
const { Content } = await render(page);
const authors = await getCollection('authors');
const posts = await getCollection('blog', ({data}) => import.meta.env.DEV || data.status === 'published');
---
<Page title={page.data.title} description={page.data.description} image={page.data.hero?.src}>
  <h1>{page.data.title}</h1>
  <p>{page.data.description}</p>
  {page.data.hero && <img src={sitePath(page.data.hero.src)} alt={page.data.hero.alt} width="720" height="360" />}
  <Content />
  {authors.map(author => <section id={author.id}>
    <h2>{author.data.name}</h2><p><strong>{author.data.role}</strong></p><p>{author.data.bio}</p>
    {author.data.website && <p><a href={author.data.website}>Website</a></p>}
    <ul>{posts.filter(post => post.data.author.id === author.id).map(post => <li><a href={sitePath(`/blog/${post.id}/`)}>{post.data.title}</a></li>)}</ul>
  </section>)}
  {page.data.callToAction && <p><a href={sitePath(page.data.callToAction.href)}>{page.data.callToAction.label} →</a></p>}
</Page>
