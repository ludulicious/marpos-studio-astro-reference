---
import OptimizedImage from '../components/OptimizedImage.astro';
import { sitePath } from '../lib/urls';
import { getCollection, render } from 'astro:content';
import Page from '../layouts/Page.astro';
export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.filter(page => !['home', 'team', 'topics', 'blog'].includes(page.id)).map(page => ({ params: {slug: page.id}, props: {page} }));
}
const { page } = Astro.props;
const { Content } = await render(page);
---
<Page title={page.data.title} description={page.data.description} image={page.data.hero?.src}>
  <div class="page-intro"><p class="breadcrumb"><a href={sitePath('/')}>Showcase</a> / {page.data.title}</p><h1>{page.data.title}</h1>
  <p class="lead">{page.data.description}</p></div>
  {page.data.hero && <OptimizedImage picture src={page.data.hero.src} alt={page.data.hero.alt} width="720" height="360" />}
  <div class="prose"><Content /></div>
  {page.data.callToAction && <p><a href={sitePath(page.data.callToAction.href)}>{page.data.callToAction.label} →</a></p>}
</Page>
