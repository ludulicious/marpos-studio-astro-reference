---
import { sitePath } from '../../lib/urls';
import { getCollection, getEntry, getEntries, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import PostList from '../../components/PostList.astro';
import VideoLesson from '../../components/VideoLesson.astro';
import { mediaAsset } from '../../lib/media';
import { chapterOrder } from '../../lib/manual';
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({data}) => import.meta.env.DEV || data.status === 'published');
  return posts.map(post => ({params: {slug: post.id}, props: {post}}));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const chapters = (await getCollection('blog', ({data}) => import.meta.env.DEV || data.status === 'published')).sort(chapterOrder);
const current = chapters.findIndex(chapter => chapter.id === post.id);
const next = chapters[current + 1];
const previous = chapters[current - 1];
const videos = (await getEntries(post.data.videos)).filter(Boolean).map(mediaAsset);
const author = await getEntry(post.data.author);
const categories = await getEntries(post.data.categories);
const related = (await getEntries(post.data.relatedPosts ?? []))
  .filter(entry => entry && (import.meta.env.DEV || entry.data.status === 'published'));
---
<Page title={post.data.title} description={post.data.description} image={post.data.hero?.src}>
  <div class="manual-layout"><aside class="manual-sidebar"><a class="manual-back" href={sitePath('/blog/')}>← All chapters</a><nav aria-label="Manual chapters">{chapters.map(chapter => <a aria-current={chapter.id === post.id ? 'page' : undefined} href={sitePath(`/blog/${chapter.id}/`)}><span>{String(chapter.data.chapter ?? '—').padStart(2,'0')}</span>{chapter.data.title}</a>)}</nav>{headings.length > 0 && <div class="on-this-page"><strong>On this page</strong>{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</div>}</aside><div class="manual-content"><article>
<p class="meta">User manual · Chapter {post.data.chapter ?? '—'} </p>
    {post.data.status === 'draft' && <p role="status">Draft preview · This story is excluded from the production build.</p>}
    <h1>{post.data.title}</h1>
    <p>{post.data.description}</p>
    <p><FormattedDate date={post.data.pubDate} /> · {post.data.readingMinutes} min read · <a href={sitePath(`/team/#${post.data.author.id}`)}>{author?.data.name ?? post.data.author.id}</a></p>
    {post.data.updatedDate && <p>Updated <FormattedDate date={post.data.updatedDate} /></p>}
    <p>{categories.filter(Boolean).map(category => <a class="topic" href={sitePath(`/topics/#${category.id}`)}>{category.data.title}</a>)}</p>
    {post.data.hero && <img src={sitePath(post.data.hero.src)} alt={post.data.hero.alt} width="720" height="360" />}
    <div class="prose"><Content /></div>
    {videos.length > 0 && <section class="lesson-videos"><h2>Watch & learn</h2>{videos.filter(Boolean).map(video => <VideoLesson video={video} />)}</section>}
    {post.data.tags.length > 0 && <p>Filed under: {post.data.tags.join(', ')}</p>}
  </article>
  <nav class="chapter-pagination" aria-label="Chapter navigation">{previous && <a href={sitePath(`/blog/${previous.id}/`)}>← Previous<span>{previous.data.title}</span></a>}{next && <a href={sitePath(`/blog/${next.id}/`)}>Next chapter →<span>{next.data.title}</span></a>}</nav>
  {related.length > 0 && <section><h2>Keep reading</h2><PostList posts={related} /></section>}
</div></div>
</Page>
<style>.topic { display: inline-block; margin-right: 1em; }</style>
