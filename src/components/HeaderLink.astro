---
import { sitePath } from '../lib/urls';
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const target = String(href ?? '/');
const pathname = '/' + Astro.url.pathname.slice(import.meta.env.BASE_URL.length).replace(/^\/+/, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = target.replace(/\/$/, '') === pathname.replace(/\/$/, '') || target.replace(/\/$/, '') === '/' + (subpath?.[0] || '');
---

<a href={sitePath(target)} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
