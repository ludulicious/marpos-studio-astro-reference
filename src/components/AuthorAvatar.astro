---
import type { CollectionEntry } from 'astro:content';
import OptimizedImage from './OptimizedImage.astro';

interface Props {
  author: Pick<CollectionEntry<'authors'>['data'], 'name' | 'avatar'>;
  size?: number;
  class?: string;
}

const { author, size = 40, class: className } = Astro.props;
const initials = author.name.trim().split(/\s+/).slice(0, 2).map(word => word[0]).join('');
---
<!-- The adjacent author name labels this decorative portrait. -->
<span class:list={['author-avatar', className]} style={`--avatar-size: ${size}px`} aria-hidden="true">
  {author.avatar
    ? <OptimizedImage src={author.avatar.src} alt="" width={size * 2} widths={[size, size * 2]} sizes={`${size}px`} loading="lazy" />
    : initials}
</span>
<style>
  .author-avatar {
    display: inline-grid;
    place-items: center;
    width: var(--avatar-size);
    height: var(--avatar-size);
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 50%;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: calc(var(--avatar-size) * .32);
    font-weight: 600;
    line-height: 1;
  }
  .author-avatar :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
  }
</style>
