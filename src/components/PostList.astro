---
import { sitePath } from '../lib/urls';
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'blog'>[] }
const { posts } = Astro.props;
---
<ol class="lesson-list">
{posts.map(post => <li data-search-item data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}>
  <span class="chapter-number" aria-label={`Chapter ${post.data.chapter ?? ''}`}>{post.data.chapter ? String(post.data.chapter).padStart(2,'0') : '—'}</span>
  <div><p class="meta">{post.data.readingMinutes} min read{post.data.videos.length > 0 && ' · Includes video'}{post.data.status === 'draft' && ' · Draft preview'}</p><h2><a href={sitePath(`/blog/${post.id}/`)}>{post.data.title}</a></h2><p>{post.data.description}</p></div>
  {post.data.hero && <a class="lesson-image" href={sitePath(`/blog/${post.id}/`)} tabindex="-1" aria-hidden="true"><img src={sitePath(post.data.hero.src)} alt="" width="240" height="180" loading="lazy" /></a>}
</li>)}
</ol>
