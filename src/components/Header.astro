---
import { sitePath } from '../lib/urls';
import HeaderLink from './HeaderLink.astro';
import Brand from './Brand.astro';
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <Brand />
  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" hidden>Menu <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14" /><path d="M3 14h14" /></svg></button>
  <div class="site-navigation" id="site-navigation">
    <nav aria-label="Main navigation">
      <HeaderLink href="/blog/">User manual</HeaderLink>
      <HeaderLink href="/library/">Media library</HeaderLink>
      <HeaderLink href="/topics/">Topics</HeaderLink>
      <HeaderLink href="/team/">Contributors</HeaderLink>
      <HeaderLink href="/about/">About</HeaderLink>
    </nav>
    <a class="header-cta" href={sitePath('/#explore')}>Explore the demo <span aria-hidden="true">↗</span></a>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const toggle = header.querySelector<HTMLButtonElement>('.nav-toggle')!;
  const closeMenu = () => {
    header.classList.remove('is-open');
    toggle.setAttribute('aria-expanded', 'false');
  };
  toggle.hidden = false;
  header.classList.add('navigation-ready');
  toggle.addEventListener('click', () => {
    const open = header.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(open));
  });
  header.addEventListener('keydown', event => {
    if (event.key === 'Escape' && header.classList.contains('is-open')) {
      closeMenu();
      toggle.focus();
    }
  });
  header.querySelectorAll('.site-navigation a').forEach(link => link.addEventListener('click', closeMenu));
</script>
