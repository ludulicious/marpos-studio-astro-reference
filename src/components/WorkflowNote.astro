---
interface Props {
  title: string;
  tone?: 'info' | 'success' | 'warning';
  compact?: boolean;
}
const { title, tone = 'info', compact = false } = Astro.props;
---
<aside class:list={["workflow-note", {compact}]} data-tone={tone} data-mdx-example>
  <h2>{title}</h2>
  <slot />
</aside>
<style>
  .workflow-note {
    margin-block: 2rem;
    padding: 1.5rem;
    border-inline-start: 4px solid var(--color-accent);
    border-radius: 0 0.5rem 0.5rem 0;
    background: var(--color-accent-soft);
  }
  .workflow-note[data-tone="success"] { border-color: #187348; background: #edf8f0; }
  .workflow-note[data-tone="warning"] { border-color: #996400; background: #fff7df; }
  .workflow-note.compact { padding: 0.75rem 1rem; }
  .workflow-note h2 { margin-top: 0; font-size: 1.4rem; }
  .workflow-note :global(ol) { margin-bottom: 0; }
</style>
