---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<aside class="workflow-note" data-mdx-example>
  <h2>{title}</h2>
  <slot />
</aside>
<style>
  .workflow-note {
    margin-block: 2rem;
    padding: 1.5rem;
    border-inline-start: 4px solid var(--accent);
    border-radius: 0 0.5rem 0.5rem 0;
    background: rgba(var(--gray-light), 0.45);
  }
  .workflow-note h2 { margin-top: 0; font-size: 1.4rem; }
  .workflow-note :global(ol) { margin-bottom: 0; }
</style>
