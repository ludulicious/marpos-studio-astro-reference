---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageMotion from '../components/PageMotion.astro';
interface Props { title: string; description: string; image?: string; home?: boolean }
const { home = false, ...metadata } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head><BaseHead {...metadata} /></head>
  <body class:list={{ 'is-home': home }}><Header /><main id="main" class:list={{ 'home-main': home }}><slot /></main><Footer /><PageMotion /></body>
</html>
